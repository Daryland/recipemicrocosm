# --- Database ---
# Hosted Postgres connection string (e.g. Neon, created from Vercel -> Storage).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Email (magic link) sign-in ---
# Any SMTP provider works, e.g. Gmail app password, Resend, Postmark.
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM="Recipe MicroCosm <noreply@example.com>"

# Recipe finder chat (local Ollama; model must support tool calling)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# Optional: only for hosted Ollama or an auth proxy
OLLAMA_API_KEY=""

# Address for the footer's "Get in touch" link. Leave empty to hide the link.
CONTACT_EMAIL=

# Optional: extra link scanning for the contact form (free key at virustotal.com).
VIRUSTOTAL_API_KEY=
