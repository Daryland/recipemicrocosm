# --- Database ---
# Dev default: local SQLite file, zero setup.
# For production (e.g. Vercel), switch prisma/schema.prisma provider to "postgresql"
# and point this at a hosted Postgres instance (Supabase/Neon both have free tiers).
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google sign-in ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in ---
# Requires an Apple Developer account. Create a Services ID + Sign in with Apple key
# at https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_SECRET is a signed JWT you generate from your private key (not a static string).
# Redirect URI: http://localhost:3000/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Email (magic link) sign-in ---
# Any SMTP provider works, e.g. Gmail app password, Resend, Postmark.
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM="Recipe MicroCosm <noreply@example.com>"
